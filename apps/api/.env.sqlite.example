ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./agent_yhzh.db
CHECKPOINT_DATABASE_URL=memory://
REDIS_URL=redis://127.0.0.1:6379/0
AUTO_MIGRATE=true
ADMIN_API_KEY=change-me-admin-key
ADMIN_SERVICE_TOKEN=change-me-admin-service-token
AGENT_SERVICE_TOKEN=change-me-agent-service-token
OPS_API_KEY=change-me-ops-key
USER_HASH_SALT=change-me-user-salt
CONFIG_ENCRYPTION_KEY=change-me-config-encryption-key
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
EXPOSE_PUBLIC_DOCS=false
DEFAULT_TENANT_ID=default
DEFAULT_SPACE_ID=default
INTERACTION_RETENTION_DAYS=30
CANDIDATE_REVIEW_THRESHOLD=2
CANDIDATE_MIN_DISTINCT_USERS=2
REQUEST_RATE_LIMIT_PER_MINUTE=60
ALLOW_PRIVATE_MODEL_URLS=true
CELERY_TASK_ALWAYS_EAGER=true
MODEL_NAME=openai/gpt-5.4-mini
MODEL_BASE_URL=
OPENAI_API_KEY=
EMBEDDING_MODEL=local/hash-1536
EMBEDDING_DIMENSIONS=1536
OBJECT_STORE_BACKEND=local
OBJECT_STORE_PATH=.data/objects
