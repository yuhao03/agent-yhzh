# Infrastructure
POSTGRES_DB=agent_yhzh
POSTGRES_USER=agent_yhzh
POSTGRES_PASSWORD=agent_yhzh_dev
DATABASE_URL=postgresql+asyncpg://agent_yhzh:agent_yhzh_dev@127.0.0.1:5432/agent_yhzh
CHECKPOINT_DATABASE_URL=postgresql://agent_yhzh:agent_yhzh_dev@127.0.0.1:5432/agent_yhzh
REDIS_URL=redis://127.0.0.1:6379/0
AUTO_MIGRATE=true

# Service identity and security - replace every value outside local development
ADMIN_API_KEY=change-me-admin-key
ADMIN_SERVICE_TOKEN=change-me-admin-service-token
AGENT_SERVICE_TOKEN=change-me-agent-service-token
OPS_API_KEY=change-me-ops-key
USER_HASH_SALT=change-me-user-salt
ADMIN_SESSION_SECRET=change-me-session-secret
USER_SESSION_SECRET=change-me-user-session-secret
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
EXPOSE_PUBLIC_DOCS=false
DEFAULT_TENANT_ID=default
DEFAULT_SPACE_ID=default

# Learning and retention
INTERACTION_RETENTION_DAYS=30
CANDIDATE_REVIEW_THRESHOLD=2
CANDIDATE_MIN_DISTINCT_USERS=2
REQUEST_RATE_LIMIT_PER_MINUTE=60
CELERY_TASK_ALWAYS_EAGER=false

# Model gateway. Local deterministic embeddings work without a model key.
MODEL_NAME=openai/gpt-5.4-mini
OPENAI_API_KEY=
EMBEDDING_MODEL=local/hash-1536
EMBEDDING_DIMENSIONS=1536

# Object storage
OBJECT_STORE_BACKEND=s3
OBJECT_STORE_PATH=.data/objects
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=agent_yhzh
S3_SECRET_KEY=agent_yhzh_dev
S3_BUCKET=agent-yhzh
S3_REGION=us-east-1
DOCUMENT_MAX_BYTES=20971520

# Frontend server-only settings
BACKEND_URL=http://127.0.0.1:8123
LANGGRAPH_DEPLOYMENT_URL=http://127.0.0.1:8123/ag-ui
COPILOTKIT_TELEMETRY_DISABLED=true

# Optional observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://127.0.0.1:3001
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
