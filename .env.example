# Infrastructure
POSTGRES_DB=agent_yhzh
POSTGRES_USER=agent_yhzh
POSTGRES_PASSWORD=agent_yhzh_dev
DATABASE_URL=postgresql+asyncpg://agent_yhzh:agent_yhzh_dev@127.0.0.1:5432/agent_yhzh
CHECKPOINT_DATABASE_URL=postgresql://agent_yhzh:agent_yhzh_dev@127.0.0.1:5432/agent_yhzh
REDIS_URL=redis://127.0.0.1:6379/0

# Backend security - change outside local development
ADMIN_API_KEY=change-me-admin-key
USER_HASH_SALT=change-me-user-salt
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Optional model gateway. The app has an offline fallback without a key.
MODEL_NAME=openai/gpt-5.4-mini
OPENAI_API_KEY=

# Frontend server-only settings
BACKEND_URL=http://127.0.0.1:8123
LANGGRAPH_DEPLOYMENT_URL=http://127.0.0.1:8123/ag-ui
ADMIN_SESSION_SECRET=change-me-session-secret
COPILOTKIT_TELEMETRY_DISABLED=true
